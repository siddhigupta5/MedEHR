generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
}

model User {
  id        Int      @id @default(autoincrement())
  fname     String
  lname     String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  records   Record[]
}

model Record {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  fileUrl     String?

  starred     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  ownerId     Int
  owner        User @relation(fields: [ownerId], references: [id])
}